+
+/* The media.file command's result, in display.draw_file's shape. On
+ * success `bytes` is the file size and `ms` the time until playback
+ * started. On failure `code` and `message` say why, in the same words
+ * as the other commands' errors. The strings are valid only for the
+ * duration of the callback. */
+typedef struct {
+    bool ok;
+    size_t bytes;
+    uint32_t ms;
+    const char *code;
+    const char *message;
+} muse_media_result_t;
+
+typedef void (*muse_media_done_cb)(const muse_media_result_t *r, void *user);
+
+/* Fetches the MP3 file at `path` on the VM and plays it: a resident
+ * worker fetches and decodes it, and the voice task plays the PCM.
+ * Reports through `done` once playback is handed to the voice task
+ * (or at once, with an error). False, with *code and *message set, if
+ * the fetch cannot start. One fetch at a time. */
+bool muse_media_start(const char *path, muse_media_done_cb done, void *user,
+                      const char **code, const char **message);
+
+#ifdef __cplusplus
+}
+#endif
